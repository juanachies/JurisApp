{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "JurisApp",
    "Audience": "JurisApp",
    "ExpiresInMinutes": 60
  },
  "FileStorage": {
    "BasePath": "uploads"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "EmailVerification": {
    "CodeExpirationMinutes": 15
  },
  "PasswordReset": {
    "FrontendBaseUrl": "http://localhost:5173",
    "TokenExpirationMinutes": 60
  }
}